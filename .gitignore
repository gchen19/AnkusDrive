__pycache__/
*.pyc
*.FCBak
*.egg-info/
scratch/out/
.venv/
.venv-bempp/                 # dedicated bempp-cl venv (meshio>=5 clash isolation)
.venv-openems/               # dedicated openEMS venv (GPL, source-built)
tests/reliability_cache/
tests/multiagent_cache/
# generated CAD artifacts (scratch/gen_artifacts.py output)
results/

# `python -m build` output (release flow: build -> twine check -> clean-venv install)
build/
dist/

# Legal / trademark filing correspondence. These carry the applicant's name,
# address and contact details, so they must not ride along into a repo that is
# headed for public. Keep the files on disk, keep them out of the history — the
# secret scan in CI does not look for PII, and history is forever once pushed.
*Filing-Record*
docs/*.docx

# Agent tool state. `.claude/settings.local.json` is covered by most people's
# global ignore, but its rotated backups (`.bak-<timestamp>`) are not, and those
# are the risky half: a permission allowlist is a list of commands with absolute
# paths in them, so the file is a transcript of this machine's home directory.
# Ignore the directory outright, repo-local so it holds on every clone rather
# than only where a global ignore happens to be configured.
.claude/
